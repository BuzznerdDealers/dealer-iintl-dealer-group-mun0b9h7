{
  "version": 2,
  "id": "post",
  "name": "Post template",
  "conditions": [
    {
      "type": "allPosts",
      "ref": null
    }
  ],
  "nodes": [
    {
      "id": "header",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 3,
        "background": "card"
      },
      "children": [
        {
          "id": "header-row",
          "type": "row",
          "props": {
            "gap": 5,
            "align": "center",
            "stackOn": "mobile"
          },
          "children": [
            {
              "id": "header-brand",
              "type": "column",
              "props": {
                "span": 3,
                "align": "center"
              },
              "children": [
                {
                  "id": "logo",
                  "type": "logo",
                  "props": {
                    "url": "/",
                    "height": 34
                  }
                }
              ]
            },
            {
              "id": "header-nav",
              "type": "column",
              "props": {
                "span": 6,
                "align": "center"
              },
              "children": [
                {
                  "id": "main-nav",
                  "type": "menu",
                  "props": {
                    "menuId": "main",
                    "layout": "horizontal",
                    "align": "center",
                    "collapseOnMobile": true
                  }
                }
              ]
            },
            {
              "id": "header-cta",
              "type": "column",
              "props": {
                "span": 3,
                "align": "center"
              },
              "children": [
                {
                  "id": "header-button",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "ctaId": "browse-inventory"
                      }
                    ],
                    "align": "left"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "content",
      "type": "contentArea",
      "props": {
        "label": "Page content"
      }
    },
    {
      "id": "more-posts",
      "type": "section",
      "props": {
        "paddingY": 6
      },
      "children": [
        {
          "id": "more-posts-row",
          "type": "row",
          "props": {},
          "children": [
            {
              "id": "more-posts-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "more-posts-feed",
                  "type": "widget",
                  "props": {
                    "widget": "post-feed",
                    "config": {
                      "heading": "More posts like this",
                      "tagSource": "post",
                      "tags": [],
                      "excludeTags": [],
                      "sort": "newest",
                      "limit": 3,
                      "layout": "cards"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "footer",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 7,
        "background": "ink"
      },
      "children": [
        {
          "id": "footer-row",
          "type": "row",
          "props": {
            "gap": 6,
            "align": "start"
          },
          "children": [
            {
              "id": "footer-brand",
              "type": "column",
              "props": {
                "span": 4
              },
              "children": [
                {
                  "id": "footer-logo",
                  "type": "logo",
                  "props": {
                    "url": "/",
                    "height": 28
                  }
                }
              ]
            },
            {
              "id": "footer-links",
              "type": "column",
              "props": {
                "span": 4
              },
              "children": [
                {
                  "id": "footer-nav",
                  "type": "menu",
                  "props": {
                    "menuId": "footer",
                    "layout": "vertical"
                  }
                }
              ]
            },
            {
              "id": "footer-legal",
              "type": "column",
              "props": {
                "span": 4
              },
              "children": [
                {
                  "id": "legal-nav",
                  "type": "menu",
                  "props": {
                    "menuId": "legal",
                    "layout": "vertical"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
