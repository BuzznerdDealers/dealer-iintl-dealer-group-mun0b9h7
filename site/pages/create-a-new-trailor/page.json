{
  "version": 2,
  "nodes": [
    {
      "id": "main-section",
      "type": "section",
      "props": {
        "width": "boxed"
      },
      "children": [
        {
          "id": "content-row",
          "type": "row",
          "props": {
            "gap": 6
          },
          "children": [
            {
              "id": "image-column",
              "type": "column",
              "props": {
                "span": 6
              },
              "children": [
                {
                  "id": "image-widget",
                  "type": "image",
                  "props": {
                    "image": {
                      "src": "/media/demo-image.jpg",
                      "alt": "A descriptive image of the trailer"
                    }
                  }
                }
              ]
            },
            {
              "id": "text-column",
              "type": "column",
              "props": {
                "span": 6
              },
              "children": [
                {
                  "id": "heading-widget",
                  "type": "heading",
                  "props": {
                    "text": "Introducing the New Trailer",
                    "headingLevel": 1
                  }
                },
                {
                  "id": "description-text",
                  "type": "text",
                  "props": {
                    "text": "Discover the latest features and specifications of our new trailer model, designed for maximum efficiency and reliability."
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
